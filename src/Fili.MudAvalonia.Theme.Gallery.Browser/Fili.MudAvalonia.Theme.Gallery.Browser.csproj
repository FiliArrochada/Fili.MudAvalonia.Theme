<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The gallery in the browser, published to GitHub Pages by .github/workflows/pages.yml.

    Building it needs the wasm-tools workload (`dotnet workload install wasm-tools`): Avalonia.Browser
    ships Skia and HarfBuzz as native static libraries that are linked into dotnet.wasm, and that
    native link is what the workload provides.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fili.MudAvalonia.Theme.Gallery.Browser</RootNamespace>
    <AssemblyName>Fili.MudAvalonia.Theme.Gallery.Browser</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Noto Sans Arabic, the fallback for the gallery's right-to-left section. A browser has no
      system fonts to fall back on: the only faces this build can draw with are the ones it ships,
      and neither Roboto nor Inter has Arabic glyphs, so without this the Arabic labels render
      as nothing. Desktop never needed it because the OS supplies an Arabic face.
      Static Regular and Medium rather than the variable file, for the same reason the theme
      embeds static Roboto: Avalonia picks a face per weight instead of setting an axis.
      SIL Open Font License 1.1; the licence travels with the files in Assets/Fonts/OFL.txt.
    -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fili.MudAvalonia.Theme.Gallery\Fili.MudAvalonia.Theme.Gallery.csproj" />
  </ItemGroup>

</Project>
