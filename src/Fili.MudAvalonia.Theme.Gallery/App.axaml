<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fili.MudAvalonia.Theme.Gallery.App"
             RequestedThemeVariant="Light">

  <!--
    The whole theme, exactly as a consuming app writes it: the forked base first, then FiliTheme.
    Order is load-bearing - later styles win, which is what lets the hand-written control themes
    beat their forked counterparts.
  -->
  <Application.Styles>
    <StyleInclude Source="avares://Fili.MudAvalonia.Theme/Themes/Base/FiliBaseTheme.axaml" />
    <StyleInclude Source="avares://Fili.MudAvalonia.Theme/FiliTheme.axaml" />
  </Application.Styles>

</Application>
