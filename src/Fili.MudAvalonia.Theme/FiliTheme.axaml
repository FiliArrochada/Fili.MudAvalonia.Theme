  <!-- END GENERATED -->

  <!-- ============================== Controls ==============================
       VARIANTS ONLY. The templates live in Themes/Controls/, keyed by type.
  -->

  <!--
    MudButton.Variant defaults to Variant.Text, so an unclassed Button is already the text one.
    Only the VARIANT switches theme here; colour and size are classes the active theme reads
    itself (Themes/Controls/Button.axaml), so `filled primary small` composes.
  -->
  <Style Selector="Button.text">
    <Setter Property="Theme" Value="{StaticResource FiliTextButton}" />
  </Style>

  <Style Selector="Button.outlined">
    <Setter Property="Theme" Value="{StaticResource FiliOutlinedButton}" />
  </Style>

  <Style Selector="Button.filled">
    <Setter Property="Theme" Value="{StaticResource FiliFilledButton}" />
  </Style>

  <!--
    MudChip is a theme a Button or ToggleButton takes, not a variant of the button, so `chip` wins
    over `outlined` / `filled` here by coming after them; the chip theme reads those classes itself
    as ITS variants. Themes/Controls/Chip.axaml.
  -->
  <Style Selector="Button.chip">
    <Setter Property="Theme" Value="{StaticResource FiliChip}" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Theme" Value="{StaticResource FiliChip}" />
  </Style>

  <!--
    The icon of an icon button. MudBlazor sizes it with font-size on the MudIcon; Avalonia's PathIcon
    is sized by Width/Height, so these set it: 24px (`.mud-icon-button` 1.5rem), 18px small
    (1.125rem), 36px large for a text icon button (`.mud-icon-size-large` 2.25rem) and 32px large
    for an outlined or filled one (2rem). A local Width/Height on the icon still wins.
  -->
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Button.icon.small PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.icon.large PathIcon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector="Button.icon.large.outlined PathIcon, Button.icon.large.filled PathIcon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
  </Style>

  <Style Selector="TextBox.filled">
    <Setter Property="Theme" Value="{StaticResource FiliFilledTextBox}" />
  </Style>

  <Style Selector="TextBox.outlined">
    <Setter Property="Theme" Value="{StaticResource FiliOutlinedTextBox}" />
  </Style>

  <Style Selector="ComboBox.filled">
    <Setter Property="Theme" Value="{StaticResource FiliFilledComboBox}" />
  </Style>

  <Style Selector="ComboBox.outlined">
    <Setter Property="Theme" Value="{StaticResource FiliOutlinedComboBox}" />
  </Style>

  <!--
    ============================== Drawer ==============================

    SplitView is MudDrawer, and it is the one control here treated with STYLES rather than with a
    ControlTheme. That is deliberate, and the reasoning is the same one that deleted the
    ScrollViewer and Window themes.

    Everything MudDrawer contributes is a VALUE, not a shape. layout/_drawer.scss gives it
    the drawer-background and drawer-text palette tokens;
    LayoutProperties.cs gives `DrawerWidthLeft = "240px"` and `DrawerMiniWidthLeft = "56px"`,
    which are already FiliDrawerWidth and FiliDrawerMiniWidth; MudDrawer.Elevation defaults to 1.
    None of that needs a template.

    What the template DOES carry is the pane sliding, the display modes and the light-dismiss
    layer - structure, where a wrong part name produces a drawer that lays out perfectly and
    never opens. So the fork keeps it, and these styles change what it paints from.

    Note the mechanism: a Style outranks a ControlTheme setter, which is normally the trap this
    file warns about and is exactly what makes this work. The forked theme's own
    OpenPaneLength/CompactPaneLength/PaneBackground setters lose to these.

    Not carried over: the pane's elevation-1 shadow, because the pane root is a Panel and only a
    Border can carry a BoxShadow. Adding one means owning the template.
  -->
  <Style Selector="SplitView">
    <Setter Property="OpenPaneLength" Value="{DynamicResource FiliDrawerWidth}" />
    <Setter Property="CompactPaneLength" Value="{DynamicResource FiliDrawerMiniWidth}" />
    <Setter Property="PaneBackground" Value="{DynamicResource FiliDrawerBackgroundBrush}" />
  </Style>

  <!--
    The pane's edge. Avalonia's Simple SplitView already carries a 1px Rectangle for it, named
    HCPaneBorder and left Transparent, so no fork edit and no ControlTheme are needed - only a
    Fill. It stays invisible in light and dark, where the drawer is separated by its own
    background, and appears in High Contrast, where both grounds are black and the rail would
    otherwise dissolve into the page.

    THE FOUR SELECTORS ARE NOT PADDING, and this is the sharpest priority rule in Avalonia:

      Animation < LocalValue < StyleTrigger < Template < Style

    Lower binds harder. A value written INSIDE a ControlTemplate - like this rectangle's
    Fill="Transparent" - binds at Template, which OUTRANKS an ordinary Style. So the obvious
    `SplitView /template/ Rectangle#HCPaneBorder` setter does nothing at all, silently, and looks
    for all the world like a selector that failed to match. Add an activator - any pseudo-class -
    and the same setter binds at StyleTrigger instead, which does win. That is also why the
    floating-label transforms elsewhere in this package work: every one of them is on a `:focus`.

    Those are the four values DisplayMode can take, so between them they are always true. Naming
    them is the honest way to buy the activator; a `:not(.some-class-nobody-applies)` would buy
    the same thing while pretending to mean something.
  -->
  <Style Selector="SplitView:inline /template/ Rectangle#HCPaneBorder,
                   SplitView:compactinline /template/ Rectangle#HCPaneBorder,
                   SplitView:overlay /template/ Rectangle#HCPaneBorder,
                   SplitView:compactoverlay /template/ Rectangle#HCPaneBorder">
    <Setter Property="Fill" Value="{DynamicResource FiliDrawerBorderBrush}" />
  </Style>

  <!-- drawer-text, on the pane only: the content beside it keeps the page's own foreground. -->
  <Style Selector="SplitView /template/ ContentPresenter#PART_PanePresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDrawerTextBrush}" />
  </Style>

  <!-- The scrim behind a temporary drawer. MudOverlay's dark variant is #212121 at 50%. -->
  <Style Selector="SplitView /template/ Rectangle#LightDismissLayer">
    <Setter Property="Fill" Value="{DynamicResource FiliOverlayDarkBrush}" />
  </Style>

  <!--
    The pickers, which are still wearing forked Simple templates. Type and radius are all a
    blanket style can safely give a control it does not template.

    Every other input used to be in this selector and has been taken out as it was templated,
    because A STYLE ALWAYS OUTRANKS A CONTROLTHEME SETTER. Left in, the CornerRadius below would
    have quietly overridden the standard field's 0 and the filled field's top-only 4,4,0,0 - the
    same trap as the TextBlock Foreground one above, in a different costume. The rule to carry
    forward: when a control gets a ControlTheme, delete it from here.
  -->
  <Style Selector="DatePicker, TimePicker, CalendarDatePicker">
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
  </Style>

</Styles>
