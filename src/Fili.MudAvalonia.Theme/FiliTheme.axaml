<!--
  Fili.MudAvalonia.Theme entry point.

  Two includes, in this order, and nothing else:

      <Application.Styles>
        <StyleInclude Source="avares://Fili.MudAvalonia.Theme/Themes/Base/FiliBaseTheme.axaml" />
        <StyleInclude Source="avares://Fili.MudAvalonia.Theme/FiliTheme.axaml" />
      </Application.Styles>

  No FluentTheme, and no Avalonia.Themes.* package reference anywhere in the library. The base
  include carries 79 templates forked from Avalonia Simple, repaletted onto this theme's tokens;
  this file carries the tokens, the type ramp, the surface classes and the hand-written control
  themes. ORDER IS LOAD-BEARING: later styles win, which is the only reason a hand-written
  ControlTheme beats its forked counterpart.

  What lives here versus in a ControlTheme:

    here            tokens, the TextBlock type ramp, Border.surface / .elevation* / .appbar,
                    and the handful of classes that name a MudBlazor VARIANT
    ControlTheme    everything about a control's template, keyed to its type

  A class is only ever a variant now - Button.primary, TextBox.filled. It is NOT how a control
  opts in to being themed; every themed control is keyed to {x:Type} and applies on its own. The
  older `.fili` marker classes are gone, because a class that means "please theme me" was only
  ever a workaround for layering over Fluent.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Fili.MudAvalonia.Theme/Themes/Palette.axaml" />
        <ResourceInclude Source="avares://Fili.MudAvalonia.Theme/Themes/Elevation.axaml" />
        <ResourceInclude Source="avares://Fili.MudAvalonia.Theme/Themes/Typography.axaml" />
        <ResourceInclude Source="avares://Fili.MudAvalonia.Theme/Themes/Geometry.axaml" />
        <!-- Last: the control themes reference tokens from all four above. -->
        <ResourceInclude Source="avares://Fili.MudAvalonia.Theme/Themes/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ============================== Type ramp ==============================
       Usage: <TextBlock Classes="h6" Text="Section" />
  -->

  <!--
    The INHERITABLE defaults go on the container, not on TextBlock.

    This matters more than it looks. FontFamily, FontSize and Foreground all inherit down the
    tree, so setting them here reaches every TextBlock without a style rule. Setting them on
    "TextBlock" instead would also hit the TextBlock a ContentPresenter generates for a
    button's string content - and a style setter beats an inherited value, so white-on-primary
    button text silently rendered in the body-text grey. Ask how that bug is found: only by
    looking, which is what the gallery is for.
  -->
  <Style Selector="Window, UserControl">
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
  </Style>

  <!--
    LineHeight and LetterSpacing do NOT go on a blanket TextBlock selector, and this is the
    third costume of the same trap.

    They were there once, set to body2's metrics on every TextBlock in the app. That silently
    CLIPS any text bigger than 20px: a 28px heading gets a 20px line box and loses its
    descenders. It cost Fili.PlaySphere every page title - "Game library" and "Settings" rendered
    with their tails cut off - and it was invisible in this package's own gallery, because the
    gallery labels everything with a ramp class that sets its own LineHeight.

    That is the giveaway: a blanket style is only safe when every control it reaches also gets
    the matching value. An adopter's own type scale never will, because it does not know this
    rule exists. So the metrics live on the ramp classes below, and unclassed text keeps the
    font's natural line height, which cannot clip.
  -->

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{DynamicResource FiliH1FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH1LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH1LetterSpacing}" />
    <Setter Property="FontWeight" Value="Light" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource FiliH2FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH2LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH2LetterSpacing}" />
    <Setter Property="FontWeight" Value="Light" />
  </Style>

  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="{DynamicResource FiliH3FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH3LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH3LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.h4">
    <Setter Property="FontSize" Value="{DynamicResource FiliH4FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH4LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH4LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.h5">
    <Setter Property="FontSize" Value="{DynamicResource FiliH5FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH5LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH5LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.h6">
    <Setter Property="FontSize" Value="{DynamicResource FiliH6FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliH6LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliH6LetterSpacing}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.subtitle1">
    <Setter Property="FontSize" Value="{DynamicResource FiliSubtitle1FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliSubtitle1LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliSubtitle1LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.subtitle2">
    <Setter Property="FontSize" Value="{DynamicResource FiliSubtitle2FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliSubtitle2LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliSubtitle2LetterSpacing}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.body1">
    <Setter Property="FontSize" Value="{DynamicResource FiliBody1FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliBody1LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliBody1LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.body2">
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliBody2LineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliBody2LetterSpacing}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FiliCaptionFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliCaptionLineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliCaptionLetterSpacing}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="{DynamicResource FiliOverlineFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource FiliOverlineLineHeight}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliOverlineLetterSpacing}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextSecondaryBrush}" />
  </Style>

  <!--
    MudText's Color: `<TextBlock Classes="body2 error" />` is `<MudText Typo="Typo.body2"
    Color="Color.Error">`. A colour class is the palette colour, as everywhere else in this theme -
    `secondary` is the secondary colour, not grey. Grey supporting text is text-secondary, which
    MudBlazor reaches with its `mud-text-secondary` utility class rather than a Color; here it is
    Foreground="{DynamicResource FiliTextSecondaryBrush}". After the type ramp on purpose, so a
    colour beats a style's own default colour (overline is text-secondary until told otherwise).
  -->
  <!-- GENERATED by ThemeColourGenerator: TextBlock colours. -->
  <Style Selector="TextBlock.primary">
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.info">
    <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.dark">
    <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!-- ============================== Surfaces ==============================
       Usage: <Border Classes="surface elevation4"> ... </Border>
  -->

  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
  </Style>

  <Style Selector="Border.outlined">
    <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource FiliBorderThickness}" />
  </Style>

  <Style Selector="Border.elevation0">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
  </Style>
  <Style Selector="Border.elevation1">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation1}" />
  </Style>
  <Style Selector="Border.elevation2">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation2}" />
  </Style>
  <Style Selector="Border.elevation4">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
  </Style>
  <Style Selector="Border.elevation6">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation6}" />
  </Style>
  <Style Selector="Border.elevation8">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
  </Style>
  <Style Selector="Border.elevation12">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation12}" />
  </Style>
  <Style Selector="Border.elevation16">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation16}" />
  </Style>
  <Style Selector="Border.elevation24">
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation24}" />
  </Style>

  <!--
    MudAlert: `<Border Classes="alert">`, from _alert.scss. Variant.Text is the default; `outlined`
    and `filled` switch it, and a colour class is the Severity (`info`, `success`, `warning`,
    `error`, and any other palette colour). With no colour it is Severity.Normal: text-primary on
    dark-hover. Text and outlined alerts draw their TEXT in the colour's darken shade and only the
    icon in the colour itself; filled ones are the colour with its contrast text, at weight 500.
    The colour is inherited, so put the message and a PathIcon inside and both follow it.
    `dense` is `.mud-dense`: 0 12px.
  -->
  <Style Selector="Border.alert">
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.alert.dense">
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Border.alert.outlined">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.alert.filled">
    <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
    <Setter Property="TextElement.FontWeight" Value="Medium" />
  </Style>
  <!-- GENERATED by ThemeColourGenerator: alert colours. -->
  <Style Selector="Border.alert.primary">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
  </Style>
  <Style Selector="Border.alert.primary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="Border.alert.secondary">
    <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
  </Style>
  <Style Selector="Border.alert.secondary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="Border.alert.tertiary">
    <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
  </Style>
  <Style Selector="Border.alert.tertiary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="Border.alert.info">
    <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliInfoDarkenBrush}" />
  </Style>
  <Style Selector="Border.alert.info PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
  </Style>
  <Style Selector="Border.alert.success">
    <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSuccessDarkenBrush}" />
  </Style>
  <Style Selector="Border.alert.success PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
  </Style>
  <Style Selector="Border.alert.warning">
    <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliWarningDarkenBrush}" />
  </Style>
  <Style Selector="Border.alert.warning PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="Border.alert.error">
    <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliErrorDarkenBrush}" />
  </Style>
  <Style Selector="Border.alert.error PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="Border.alert.dark">
    <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDarkDarkenBrush}" />
  </Style>
  <Style Selector="Border.alert.dark PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <Style Selector="Border.alert.outlined.primary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="Border.alert.outlined.secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliSecondaryBrush}" />
  </Style>
  <Style Selector="Border.alert.outlined.tertiary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliTertiaryBrush}" />
  </Style>
  <Style Selector="Border.alert.outlined.info">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
  </Style>
  <Style Selector="Border.alert.outlined.success">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
  </Style>
  <Style Selector="Border.alert.outlined.warning">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
  </Style>
  <Style Selector="Border.alert.outlined.error">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
  </Style>
  <Style Selector="Border.alert.outlined.dark">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FiliDarkBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.primary">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.primary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.secondary">
    <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.secondary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.tertiary">
    <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.tertiary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.info">
    <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.info PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.success">
    <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.success PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.warning">
    <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.warning PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.error">
    <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.error PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.dark">
    <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
  </Style>
  <Style Selector="Border.alert.filled.dark PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!--
    MudSkeleton: `<Border Classes="skeleton" Width="..." />`, from _skeleton.scss. SkeletonType.Text
    is the default - a 4px-rounded bar drawn at 60% of its height from 60% down, so a 20px line
    (body2's line height) shows a 12px bar. `circle` and `rectangle` are the other two types, at
    `.mud-skeleton`'s 1.2em unless sized. Animation.Pulse is the default and the only one here:
    opacity 1 -> 0.4 -> 1 over 1.5s, ease-in-out, after a 0.5s delay, for ever.
  -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource FiliSkeletonBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="Height" Value="20" />
    <Setter Property="RenderTransformOrigin" Value="0%,60%" />
    <Setter Property="RenderTransform" Value="scaleY(0.6)" />
    <Style.Animations>
      <Animation Duration="0:0:1.5" Delay="0:0:0.5" IterationCount="Infinite" Easing="0.42,0,0.58,1">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.4" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.skeleton.circle">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Height" Value="16.8" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Border.skeleton.rectangle">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Height" Value="16.8" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- App bar -->
  <!--
    The text colour is INHERITED from the bar, not set on every TextBlock inside it. The blanket
    `Border.appbar TextBlock` it replaces matched through the LOGICAL tree, which includes a
    dropdown's items - they render in a popup on a white surface but are logical children of the
    control on the bar - so an app-bar ComboBox opened onto white text on white. Inherited, the
    colour reaches plain text and loses to every control that sets its own, which is also
    MudBlazor's behaviour: .mud-input paints text-primary wherever it sits. A control that should
    read in the bar's colour says so itself. Pinned by AppBarTests.
  -->
  <Style Selector="Border.appbar">
    <Setter Property="Background" Value="{DynamicResource FiliAppbarBackgroundBrush}" />
    <Setter Property="Height" Value="{DynamicResource FiliAppbarHeight}" />
    <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliAppbarTextBrush}" />
    <!-- MudAppBar.Gutters defaults to true: _toolbar.scss's .mud-toolbar-gutters, 24px a side
         from the sm breakpoint up. An app that wants none sets Padding="0". -->
    <Setter Property="Padding" Value="24,0" />
  </Style>
  <!-- Dense: .mud-appbar-dense, the bar height less a quarter, 64 -> 48. -->
  <Style Selector="Border.appbar.dense">
    <Setter Property="Height" Value="48" />
  </Style>

  <!-- MudAppBar's Color is .mud-theme-{color}: the colour as the ground, its contrast text
       inherited by the content. -->
  <!-- GENERATED by ThemeColourGenerator: app bar colours. -->
  <Style Selector="Border.appbar.primary">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.secondary">
    <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.tertiary">
    <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.info">
    <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.success">
    <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.warning">
    <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.error">
    <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
  </Style>
  <Style Selector="Border.appbar.dark">
    <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
  </Style>
  <!-- END GENERATED -->

  <!--
    MudTabs' Color, on a TabControl or TabStrip: the bar in the colour, the tabs and indicator in
    its contrast text. The rest of MudTabs lives in Controls/TabControl.axaml and TabStrip.axaml.
  -->
  <!-- GENERATED by ThemeColourGenerator: tab bar colours. -->
  <Style Selector="TabControl.primary /template/ Border#PART_TabBar">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="TabStrip.primary">
    <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
  </Style>
  <Style Selector="TabControl.primary > TabItem">
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
  </Style>
  <Style Selector="TabControl.primary > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
  </Style>
  <Style Selector="TabControl.primary > TabItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
