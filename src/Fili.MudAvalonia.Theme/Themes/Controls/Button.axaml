<!--
  Button: MudButton. Transcribed from _button.scss and MudButton.razor.cs.

  Three kinds of class, combined the way MudButton's parameters are:

    Variant   text (the default - MudButton.Variant defaults to Variant.Text), outlined, filled
    Color     none (Color.Default), primary, secondary, tertiary, info, success, warning, error,
              dark, inherit
    Size      none (Size.Medium), small, large

    <Button Content="Learn more" />                        text, default colour
    <Button Classes="primary" Content="Learn more" />      text, primary
    <Button Classes="outlined error" Content="Delete" />   outlined, error
    <Button Classes="filled primary" Content="Save" />     filled, primary
    <Button Classes="filled success small" Content="OK" /> filled, success, small

  A colour class is ONLY a colour, as Color is in MudBlazor. `primary` on its own is a primary
  TEXT button; the fill comes from `filled`. Each variant follows one rule for every colour:

    text      colour as text; hover, focus and press tint with {color}-hover (the colour at 6%)
    outlined  the same, plus a 1px line in the colour (BorderOpacity is 1.0, so it IS the colour)
    filled    colour as fill, {color}-text on it; hover, focus and press switch the fill to
              {color}-darken, and elevation goes 2 -> 4 (hover, focus) -> 8 (press)

  With no colour, text and outlined use text-primary (and so does outlined's line), tinting with
  action-default-hover. A filled button with no colour is grey: action-default-hover as the
  fill, action-disabled-background on hover.

  :active and :focus-visible share the hover value in _button.scss, so press is not a stronger
  tint here either. MudBlazor's extra press feedback is the ripple, the part with no Avalonia
  primitive: an animated, clipped ellipse driven from pointer position.

  GENERATED by ButtonThemeGenerator (tst/Fili.MudAvalonia.Theme.UnitTests/Generation) from one
  list of colours, so every colour follows exactly the same rules. Do not hand-edit one colour's
  block: change the generator, then rewrite this file with FILI_REGENERATE=1 (GeneratedThemeTests).

  Order inside each theme is load-bearing: defaults, then colours, then sizes, then disabled.
  Of two styles matching the same element, the later one wins - so a colour beats the default
  tint, and disabled beats everything.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Text: `.mud-button-text`. No fill, no elevation, ever. -->
  <ControlTheme x:Key="FiliTextButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <!-- State layer. Sits under the content, over the fill. -->
            <Border x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- No colour: action-default-hover. Keyboard focus paints the same tint - that IS the
         affordance in MudBlazor, whose _reset.scss drops the browser focus ring. -->
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <Style Selector="^.primary">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>

    <!-- Color.Inherit: `color: inherit`. Bound to the parent's inherited text colour, because a
         ControlTheme setter cannot withdraw its own Foreground and fall back to inheriting. -->
    <Style Selector="^.inherit">
      <Setter Property="Foreground" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
    </Style>

    <!-- `.mud-button-text-size-*`: 4px 5px / 8px 11px at 0.8125rem / 0.9375rem. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="5,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!--
    Outlined: `.mud-button-outlined`. The text button plus a 1px line, at 5px 15px so the line
    does not grow the button. The line is text-primary at BorderOpacity, which Palette.cs sets to
    1.0 - a hard line in the text colour, not the faint input outline.
  -->
  <ControlTheme x:Key="FiliOutlinedButton" TargetType="Button" BasedOn="{StaticResource FiliTextButton}">
    <Setter Property="BorderBrush" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="15,5" />

    <Style Selector="^.primary">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliDarkBrush}" />
    </Style>

    <!-- `.mud-button-outlined-inherit`: `border-color: currentColor`. -->
    <Style Selector="^.inherit">
      <Setter Property="BorderBrush" Value="{Binding $self.Foreground}" />
    </Style>

    <!-- `.mud-button-outlined-size-*`: 3px 9px / 7px 21px. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="21,7" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <Style Selector="^:disabled /template/ Border#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
  </ControlTheme>

  <!--
    Filled: `.mud-button-filled`. The elevation change across rest -> hover -> press is the one
    thing a style on Button cannot do, because Button has no BoxShadow - only the Border inside
    its template does. The three shadows are the layers _button.scss spells out, which are
    FiliElevation2, 4 and 8 exactly.
  -->
  <ControlTheme x:Key="FiliFilledButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource FiliElevation2}">
          <Panel>
            <!-- State layer. Sits under the content, over the fill. -->
            <Border x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation4}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation8}" />
    </Style>

    <!-- No colour: grey, going to action-disabled-background. -->
    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>

    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>

    <!-- `.mud-button-color-inherit`: the text inherits and the grey fill stays, as in MudBlazor,
         which generates no filled-inherit class. -->
    <Style Selector="^.inherit">
      <Setter Property="Foreground" Value="{Binding $parent[Control].(TextElement.Foreground)}" />
    </Style>

    <!-- `.mud-button-filled-size-*`: 4px 10px / 8px 22px. -->
    <Style Selector="^.small">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="22,8" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Disabled drops to the ground: no shadow at all, not a dimmed one. -->
    <Style Selector="^:disabled /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!--
    MudButton defaults to Variant.Text and Color.Default, so an unclassed Button is the text one in
    text-primary. `outlined` and `filled` switch the theme (FiliTheme.axaml); colour and size
    classes work inside whichever theme is active.
  -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button" BasedOn="{StaticResource FiliTextButton}" />

</ResourceDictionary>
