    </Style>
    <Style Selector="^.text.primary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^.text.primary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^.text.primary:pressed /template/ Border#PART_StateLayer">
