<!--
  Chip: MudChip, from _chip.scss and MudChip.razor.cs. Not a new control - a theme a Button or a
  ToggleButton takes with the `chip` class:

    <Button Classes="chip" Content="Action" />                 a clickable chip
    <ToggleButton Classes="chip primary" Content="Indie" />    a selectable one, in a chip set

  MudChip.Variant defaults to Variant.FILLED (through ChipSet), unlike every button, and Color to
  Color.Default: a grey action-disabled-background pill in text-primary. `outlined` and `text`
  switch the variant; a colour class is only a colour, as on Button; `small` and `large` are the
  24px and 40px chips.

    filled    the colour as fill, {color}-text on it; darkens on hover, focus and press
    outlined  a 1px line (lines-inputs with no colour, the colour otherwise), the colour's tint
    text      the colour at 6% as fill, the colour as text; 12% on hover, focus and press

  Selection is MudChip.GetVariant's swap: a SELECTED filled chip draws as text, a selected text
  chip draws as filled, and a selected outlined chip keeps its line and gains the colour's tint.
  ToggleButton.IsChecked is the selected state.

  The 12% hover of a text chip, `rgba(color, 0.12)`, has no palette token: it is drawn as the
  colour itself on the state layer at Opacity 0.12, which is the same thing.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="FiliChip" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- `.mud-chip-size-medium`: 32px tall, a 16px radius, 14px type, 0 12px. -->
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Border x:Name="PART_StateLayer"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="Transparent" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- GENERATED by ThemeColourGenerator: chip variants, colours, selection and sizes. -->
    <!-- Filled, the default: action-disabled-background, action-disabled on hover. -->
    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryDarkenBrush}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.primary:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryDarkenBrush}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.tertiary">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryContrastTextBrush}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryDarkenBrush}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.info">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoContrastTextBrush}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliInfoDarkenBrush}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.info:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessContrastTextBrush}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessDarkenBrush}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.success:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningContrastTextBrush}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliWarningDarkenBrush}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.warning:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.error">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorContrastTextBrush}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliErrorDarkenBrush}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.error:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliDarkContrastTextBrush}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource FiliDarkDarkenBrush}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.dark:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Outlined: lines-inputs or the colour as a 1px line, the tint on hover. -->
    <Style Selector="^.outlined">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesInputsBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^.outlined:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.outlined:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.outlined:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.outlined:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.outlined:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.outlined:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.primary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.outlined.primary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.primary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.primary:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.secondary:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.tertiary:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.info">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.outlined.info:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.info:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.info:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.success">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliSuccessBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.outlined.success:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.success:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.success:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.warning">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliWarningBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.outlined.warning:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.warning:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.warning:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.error">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FiliErrorBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.outlined.error:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.error:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.outlined.error:pressed /template/ Border#PART_StateLayer">
