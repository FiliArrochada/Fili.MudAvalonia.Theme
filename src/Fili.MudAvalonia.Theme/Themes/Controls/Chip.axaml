    </Style>
    <Style Selector="^.text.info:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text.info:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text.info:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^.text.info:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
      <Setter Property="Opacity" Value="0.12" />
    </Style>
