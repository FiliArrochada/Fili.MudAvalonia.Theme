    <Style Selector="^.text.tertiary">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FiliTertiaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^.text.tertiary:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text.tertiary:focus-visible /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.text.tertiary:pressed /template/ Border#PART_Root">
