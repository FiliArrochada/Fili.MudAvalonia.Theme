<!--
  RadioButton, re-derived from MudBlazor.

  Same correction as CheckBox: MudRadio renders Material icon glyphs
  (RadioButtonChecked / RadioButtonUnchecked) rather than drawing a ring and a disc.

  That difference is not cosmetic here. The earlier hand-drawn version grew a separate inner
  disc with a scale transition - which reads well, but is not what MudBlazor does. The checked
  glyph is one path containing both ring and dot, so selection is a glyph swap and a colour
  change, with no independent animation.

  Transcribed from:
    Components/Radio/MudRadio.razor.cs   the two icon constants
    Styles/components/_radio.scss        padding: 4px around the icon
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="FiliRadioButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*">

          <!-- Size scales the glyph and its halo together: MudIcon is 20 / 24 / 36px. -->
          <LayoutTransformControl x:Name="PART_Scale" Grid.Column="0">
            <Panel Width="40" Height="40">

              <Ellipse x:Name="PART_StateLayer"
                       Width="40" Height="40"
                       Fill="Transparent" />

              <Path x:Name="PART_Unchecked"
                    Width="24" Height="24"
                    Stretch="None"
                    Data="{StaticResource FiliRadioUncheckedGeometry}"
                    Fill="{DynamicResource FiliActionDefaultBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

              <Path x:Name="PART_Checked"
                    Width="24" Height="24"
                    Stretch="None"
                    Data="{StaticResource FiliRadioCheckedGeometry}"
                    Fill="{DynamicResource FiliActionDefaultBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="False" />
            </Panel>
          </LayoutTransformControl>

          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Path#PART_Unchecked">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked /template/ Path#PART_Checked">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- GENERATED by ThemeColourGenerator: radio colours and sizes. -->
    <!-- No colour: the action-default halo. -->
    <Style Selector="^:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <!-- Colours: every glyph, checked or not, and the halo. -->
    <Style Selector="^.primary /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.info /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.success /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.warning /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.error /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.dark /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark:pointerover /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:focus-visible /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:pressed /template/ Ellipse#PART_StateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>

    <!-- `mud-icon-size-small` / `-large`: 1.25rem and 2.25rem against 1.5rem. -->
    <Style Selector="^.small /template/ LayoutTransformControl#PART_Scale">
      <Setter Property="LayoutTransform" Value="scale(0.8333333)" />
    </Style>
    <Style Selector="^.large /template/ LayoutTransformControl#PART_Scale">
      <Setter Property="LayoutTransform" Value="scale(1.5)" />
    </Style>
    <!-- END GENERATED -->

    <Style Selector="^:disabled /template/ Path#PART_Unchecked">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_Checked">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton" BasedOn="{StaticResource FiliRadioButton}" />

</ResourceDictionary>
