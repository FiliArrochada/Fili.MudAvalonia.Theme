<!--
  ScrollBar: a thin, buttonless rail.

  Material has no scrollbar of its own - the web hands that to the browser - so this follows what
  MudBlazor apps actually look like: a narrow track with a rounded thumb, no line buttons, and a
  thumb that darkens rather than changes shape.

  Dropping the line buttons is safe. ScrollBar.OnApplyTemplate looks PART_LineUpButton and
  PART_LineDownButton up and wires them if present; the lookups are null-safe, and the scroll
  gestures that matter (wheel, drag, keyboard, touch) are handled by ScrollViewer rather than by
  those buttons. What IS required is a Track named PART_Track - without it the thumb never moves.

  Both orientations need their own Template, as with Slider: width and height swap, and a
  horizontal template on a vertical bar renders a sideways rail.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="FiliScrollBarThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="4"
                Margin="2">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
          </Border.Transitions>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource FiliTextPrimaryBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliScrollBar" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="MinHeight" Value="12" />

    <!-- Vertical is the default orientation for a ScrollBar. -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Width="12">
          <Track x:Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="Vertical"
                 IsDirectionReversed="True">
            <Thumb x:Name="PART_Thumb" Theme="{StaticResource FiliScrollBarThumb}" />
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Height="12">
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="Horizontal">
              <Thumb x:Name="PART_Thumb" Theme="{StaticResource FiliScrollBarThumb}" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar" BasedOn="{StaticResource FiliScrollBar}" />

</ResourceDictionary>
