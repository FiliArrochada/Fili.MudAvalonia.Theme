<!--
  TabControl and TabItem: the Material tab strip.

  Two themes, wired together by ItemContainerTheme on the TabControl - that is what makes a bare
  <TabItem> inside a themed TabControl pick the matching header theme up without the app naming
  it. Setting the TabControl theme alone would leave the headers on the substrate.

  The Material tab is a flat strip with a 2px indicator under the selected header, in primary,
  and an uppercase-weight label that goes from secondary text to primary on selection. Fluent's
  own tab happens to be close to this already, which is part of why it is a better substrate
  than Simple - but "close" still means the wrong height, the wrong tracking and an indicator
  that is not the right thickness.

  Transcribed from _tabs.scss and MudTabs.razor.cs, whose defaults decide most of it: the bar is
  surface with no rule under it (Border defaults to false), a tab inherits the text colour, which
  is text-primary, and goes primary when active, and MinimumTabWidth defaults to 160px.

    MudTabs        here
    Color          a colour class on the TabControl: the bar in the colour, tabs in its contrast
                   text, the indicator too, and {color}-lighten on the active tab's hover
    Border         border      a lines-default rule under the bar
    Outlined       outlined    a lines-default ring round the bar
    Rounded        rounded     default-borderradius on the bar
    Centered       centered    the tab row centred in the bar

  The colours are generated, into a region of FiliTheme.axaml: a TabItem's theme cannot see its
  TabControl's class, so they are `TabControl.primary > TabItem` styles there.

  The indicator does NOT slide between tabs. A sliding indicator has to measure the previous and
  next header and animate between them, which needs code-behind and a custom panel; a per-item
  indicator that fades is the honest 90% and stays declarative.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="FiliTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliButtonFontSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="{DynamicResource FiliButtonLetterSpacing}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root" Background="Transparent">
          <Panel>
            <Border x:Name="PART_StateLayer" Background="Transparent" />

            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

            <!-- Indicator. Present always, revealed on selection, so the header does not resize. -->
            <Border x:Name="PART_Indicator"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource FiliPrimaryBrush}"
                    Opacity="0">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Indicator">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- _tabs.scss: action-default-hover on a tab, primary-hover on the active one. Keyboard
         focus paints the same tint - that IS the affordance in MudBlazor, where _reset.scss drops
         the browser ring. -->
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^:selected:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource FiliOverlayPressedBrush}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliTextDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="FiliTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <!-- This is the line that carries the header theme down to bare <TabItem> children. -->
    <Setter Property="ItemContainerTheme" Value="{StaticResource FiliTabItem}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <DockPanel>
            <Border x:Name="PART_TabBar" DockPanel.Dock="Top">
              <ItemsPresenter x:Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>

            <ContentPresenter x:Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              Margin="{TemplateBinding Padding}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!--
      The bar, from .mud-tabs-tabbar: surface, and no line under it unless asked. Each of these is
      a style rather than a value inline in the template, because a value written there binds at
      Template priority and the classes below could not move it.
    -->
    <Style Selector="^ /template/ Border#PART_TabBar">
      <Setter Property="Background" Value="{DynamicResource FiliSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FiliLinesDefaultBrush}" />
    </Style>
    <!-- Border: .mud-tabs-border-top, a lines-default rule on the content side. -->
    <Style Selector="^.border /template/ Border#PART_TabBar">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <!-- Outlined: .mud-paper-outlined on the bar. -->
    <Style Selector="^.outlined /template/ Border#PART_TabBar">
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Rounded: .mud-tabs-rounded, default-borderradius, with the tabs' tints clipped to it. -->
    <Style Selector="^.rounded /template/ Border#PART_TabBar">
      <Setter Property="CornerRadius" Value="{DynamicResource FiliCornerRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Centered: .mud-tabs-centered, `margin: auto` on the tab row. -->
    <Style Selector="^.centered /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl" BasedOn="{StaticResource FiliTabControl}" />

  <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem" BasedOn="{StaticResource FiliTabItem}" />

</ResourceDictionary>
