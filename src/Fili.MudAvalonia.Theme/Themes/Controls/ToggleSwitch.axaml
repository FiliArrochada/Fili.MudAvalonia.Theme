<!--
  ToggleSwitch: the Material switch.

  The shape is the point, and it is unlike Fluent's. Material puts a 20px thumb that is LARGER
  than its 14px track, overhanging it above and below, with elevation under the thumb. Fluent
  puts a smaller thumb inside a taller capsule. Nothing about that is reachable with setters.

  Colour is MudSwitch's, from _switch.scss and MudSwitch.razor.cs. MudSwitch.Color defaults to
  Color.Default, which adds no colour at all: the thumb stays the literal #fafafa of
  `.mud-switch-base`, on and off, over the action-default track at 48% (50% when on). A colour
  class paints the thumb and the track only when ON - `mud-{color}-text` and `mud-{color}` are
  added for BoolValue == true - with the colour's hover tint as the halo.

  PART NAMES ARE LOAD-BEARING. ToggleSwitch.OnApplyTemplate looks up PART_SwitchKnob and
  PART_MovingKnobs to wire knob dragging. The lookups are null-safe, so omitting them costs the
  drag gesture rather than crashing - but then the switch only responds to clicks, which is a
  silent downgrade. They are kept, and the checked-state transform is applied to PART_Thumb
  INSIDE PART_MovingKnobs so it composes with the drag transform instead of fighting it.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="FiliToggleSwitch" TargetType="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource FiliTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource FiliFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FiliBody2FontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="40" />

    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*">

          <Panel x:Name="PART_SwitchArea" Grid.Column="0" Width="52" Height="40">

            <!-- Track: 34x14, sits behind and is overhung by the thumb. -->
            <Border x:Name="PART_Track"
                    Width="34" Height="14"
                    CornerRadius="9"
                    Background="{DynamicResource FiliActionDefaultBrush}"
                    Opacity="0.48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            <!-- Travel area. Width is track width, so the thumb can sit at either end. -->
            <Panel x:Name="PART_SwitchKnob"
                   Width="34" Height="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

              <!-- Avalonia translates THIS panel while a drag is in progress. -->
              <Panel x:Name="PART_MovingKnobs">

                <Ellipse x:Name="PART_ThumbStateLayer"
                         Width="40" Height="40"
                         Fill="Transparent"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="-10,0,0,0"
                         RenderTransform="translateX(0px)">
                  <Ellipse.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform"
                                                     Duration="0:0:0.15"
                                                     Easing="CubicEaseOut" />
                    </Transitions>
                  </Ellipse.Transitions>
                </Ellipse>

                <Border x:Name="PART_Thumb"
                        Width="20" Height="20"
                        CornerRadius="10"
                        Background="{DynamicResource FiliSwitchThumbBrush}"
                        BoxShadow="{DynamicResource FiliElevation2}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        RenderTransform="translateX(0px)">
                  <Border.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform"
                                                     Duration="0:0:0.15"
                                                     Easing="CubicEaseOut" />
                      <BrushTransition Property="Background" Duration="0:0:0.15" />
                    </Transitions>
                  </Border.Transitions>
                </Border>
              </Panel>
            </Panel>
          </Panel>

          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- GENERATED by ThemeColourGenerator: switch colours and sizes. -->
    <!-- On: the thumb travels the track width minus its own, 34 - 20 = 14px, and the
         track lifts from 48% to 50%. -->
    <Style Selector="^:checked /template/ Border#PART_Thumb">
      <Setter Property="RenderTransform" Value="translateX(14px)" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="RenderTransform" Value="translateX(14px)" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Track">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- `.mud-switch-base:hover`: action-default-hover; keyboard focus and press the same. -->
    <Style Selector="^:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliActionDefaultHoverBrush}" />
    </Style>

    <!-- `.mud-switch-span-small`: a 30x10 track and a 14px thumb. -->
    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="^.small /template/ Panel#PART_SwitchArea">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="^.small /template/ Border#PART_Track">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="^.small /template/ Panel#PART_SwitchKnob">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="^.small /template/ Border#PART_Thumb">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="^.small /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="^.small:checked /template/ Border#PART_Thumb">
      <Setter Property="RenderTransform" Value="translateX(16px)" />
    </Style>
    <Style Selector="^.small:checked /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="RenderTransform" Value="translateX(16px)" />
    </Style>

    <!-- `.mud-switch-span-large`: a 38x18 track and a 26px thumb. -->
    <Style Selector="^.large">
      <Setter Property="MinHeight" Value="46" />
    </Style>
    <Style Selector="^.large /template/ Panel#PART_SwitchArea">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="46" />
    </Style>
    <Style Selector="^.large /template/ Border#PART_Track">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="^.large /template/ Panel#PART_SwitchKnob">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="^.large /template/ Border#PART_Thumb">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
    </Style>
    <Style Selector="^.large /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
    </Style>
    <Style Selector="^.large:checked /template/ Border#PART_Thumb">
      <Setter Property="RenderTransform" Value="translateX(12px)" />
    </Style>
    <Style Selector="^.large:checked /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="RenderTransform" Value="translateX(12px)" />
    </Style>

    <!-- Colours paint the thumb and the track only when ON, with the colour's hover tint. -->
    <Style Selector="^.primary:checked /template/ Border#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliPrimaryBrush}" />
    </Style>
    <Style Selector="^.primary:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.primary:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliPrimaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:checked /template/ Border#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliSecondaryBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.secondary:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSecondaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked /template/ Border#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliTertiaryBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.tertiary:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliTertiaryHoverBrush}" />
    </Style>
    <Style Selector="^.info:checked /template/ Border#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliInfoBrush}" />
    </Style>
    <Style Selector="^.info:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.info:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliInfoHoverBrush}" />
    </Style>
    <Style Selector="^.success:checked /template/ Border#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliSuccessBrush}" />
    </Style>
    <Style Selector="^.success:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.success:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliSuccessHoverBrush}" />
    </Style>
    <Style Selector="^.warning:checked /template/ Border#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliWarningBrush}" />
    </Style>
    <Style Selector="^.warning:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.warning:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliWarningHoverBrush}" />
    </Style>
    <Style Selector="^.error:checked /template/ Border#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliErrorBrush}" />
    </Style>
    <Style Selector="^.error:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.error:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliErrorHoverBrush}" />
    </Style>
    <Style Selector="^.dark:checked /template/ Border#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliDarkBrush}" />
    </Style>
    <Style Selector="^.dark:checked:pointerover /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:checked:focus-visible /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <Style Selector="^.dark:checked:pressed /template/ Ellipse#PART_ThumbStateLayer">
      <Setter Property="Fill" Value="{DynamicResource FiliDarkHoverBrush}" />
    </Style>
    <!-- END GENERATED -->

    <Style Selector="^:disabled /template/ Border#PART_Thumb">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource FiliElevation0}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource FiliActionDisabledBackgroundBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource FiliActionDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch" BasedOn="{StaticResource FiliToggleSwitch}" />

</ResourceDictionary>
