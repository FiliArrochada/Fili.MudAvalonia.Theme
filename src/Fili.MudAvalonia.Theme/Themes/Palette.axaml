<!--
  Palette tokens.

  Values are the MudBlazor default light and dark palettes, read from its source
  (src/MudBlazor/Themes/Models/Palette.cs and PaletteDark.cs) with the Colors.* references
  resolved to hex. MudBlazor is MIT licensed; these are colour values, not code.

  CSS rgba() alpha is folded into the Avalonia #AARRGGBB form:
    0.02 -> 05   0.04 -> 0A   0.11 -> 1C   0.12 -> 1F   0.20 -> 33   0.26 -> 42
    0.30 -> 4D   0.38 -> 61   0.50 -> 80   0.54 -> 8A   0.70 -> B3
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Fili.MudAvalonia.Theme">

  <ResourceDictionary.ThemeDictionaries>

    <!-- ============================== LIGHT ============================== -->
    <ResourceDictionary x:Key="Light">

      <Color x:Key="FiliPrimaryColor">#594AE2</Color>
      <Color x:Key="FiliPrimaryContrastTextColor">#FFFFFF</Color>
      <Color x:Key="FiliSecondaryColor">#FF4081</Color>
      <Color x:Key="FiliSecondaryContrastTextColor">#FFFFFF</Color>
      <Color x:Key="FiliTertiaryColor">#1EC8A5</Color>
      <Color x:Key="FiliTertiaryContrastTextColor">#FFFFFF</Color>

      <Color x:Key="FiliInfoColor">#2196F3</Color>
      <Color x:Key="FiliSuccessColor">#00C853</Color>
      <Color x:Key="FiliWarningColor">#FF9800</Color>
      <Color x:Key="FiliErrorColor">#F44336</Color>
      <Color x:Key="FiliDarkColor">#424242</Color>
      <Color x:Key="FiliBlackColor">#272C34</Color>
      <Color x:Key="FiliWhiteColor">#FFFFFF</Color>

      <Color x:Key="FiliTextPrimaryColor">#424242</Color>
      <Color x:Key="FiliTextSecondaryColor">#8A000000</Color>
      <Color x:Key="FiliTextDisabledColor">#61000000</Color>

      <Color x:Key="FiliActionDefaultColor">#8A000000</Color>
      <Color x:Key="FiliActionDisabledColor">#42000000</Color>
      <Color x:Key="FiliActionDisabledBackgroundColor">#1F000000</Color>

      <Color x:Key="FiliBackgroundColor">#FFFFFF</Color>
      <Color x:Key="FiliBackgroundGrayColor">#F5F5F5</Color>
      <Color x:Key="FiliSurfaceColor">#FFFFFF</Color>

      <Color x:Key="FiliAppbarBackgroundColor">#594AE2</Color>
      <Color x:Key="FiliAppbarTextColor">#FFFFFF</Color>
      <Color x:Key="FiliDrawerBackgroundColor">#FFFFFF</Color>
      <Color x:Key="FiliDrawerTextColor">#424242</Color>
      <Color x:Key="FiliDrawerIconColor">#616161</Color>
      <!-- The drawer's edge. Transparent here and in dark, where the pane is separated by its
           own background colour; High Contrast is where it has to exist, because there both
           grounds are black. Avalonia's Simple SplitView already carries the rectangle for it
           (HCPaneBorder), so lighting it up costs a Style and no template. -->
      <Color x:Key="FiliDrawerBorderColor">#00000000</Color>

      <Color x:Key="FiliLinesDefaultColor">#1F000000</Color>
      <Color x:Key="FiliLinesInputsColor">#BDBDBD</Color>
      <Color x:Key="FiliDividerColor">#E0E0E0</Color>
      <Color x:Key="FiliTableLinesColor">#E0E0E0</Color>
      <Color x:Key="FiliTableStripedColor">#05000000</Color>
      <Color x:Key="FiliTableHoverColor">#0A000000</Color>
      <Color x:Key="FiliSkeletonColor">#1C000000</Color>

      <!--
        Primary at 6%. MudBlazor Palette.cs derives it as PrimaryColor with HoverOpacity, and it
        is what a selected list row paints under itself (`mud-primary-hover`, alongside
        `mud-primary-text` on the label) - so selection is a tint plus a colour change, never a
        filled bar.
      -->
      <Color x:Key="FiliPrimaryHoverColor">#0F594AE2</Color>

      <!-- State-layer overlays. Material behaviour, not a MudBlazor palette token. -->
      <Color x:Key="FiliOverlayHoverColor">#0A000000</Color>
      <Color x:Key="FiliOverlayPressedColor">#1F000000</Color>

      <!--
        Filled-input fill. TRANSLUCENT ON PURPOSE, and this is the whole point of it: an opaque
        token cannot work, because the field has to stay visible on every ground it might sit on.
        Using FiliBackgroundGray here made filled fields vanish in dark mode, where that token IS
        the page ground. MudBlazor _input.scss paints rgba(0,0,0,.09) light and the white equivalent dark - 9% in
        both, not Material spec 6%.
      -->
      <Color x:Key="FiliInputFilledColor">#17000000</Color>

      <!--
        Non-varying between LIGHT and DARK, and that is still MudBlazor's behaviour - but they
        live in the variant dictionaries rather than below them, because HIGH CONTRAST has to
        override them and a token declared outside the theme dictionaries CANNOT be overridden
        by one: a dictionary's own entries are found before its ThemeDictionaries, so the outer
        value wins in every variant. Scrim: Palette.cs OverlayDark is #212121 at 50%, not black.
        Tooltip: _tooltip.scss paints `mud-palette-gray-darker` = Colors.Gray.Darken2, solid.
      -->
      <Color x:Key="FiliOverlayDarkColor">#80212121</Color>
      <Color x:Key="FiliOverlayLightColor">#80FFFFFF</Color>
      <Color x:Key="FiliTooltipBackgroundColor">#616161</Color>

    </ResourceDictionary>

    <!-- ============================== DARK =============================== -->
    <ResourceDictionary x:Key="Dark">

      <Color x:Key="FiliPrimaryColor">#776BE7</Color>
      <Color x:Key="FiliPrimaryContrastTextColor">#FFFFFF</Color>
      <Color x:Key="FiliSecondaryColor">#FF4081</Color>
      <Color x:Key="FiliSecondaryContrastTextColor">#FFFFFF</Color>
      <Color x:Key="FiliTertiaryColor">#1EC8A5</Color>
      <Color x:Key="FiliTertiaryContrastTextColor">#FFFFFF</Color>

      <Color x:Key="FiliInfoColor">#3299FF</Color>
      <Color x:Key="FiliSuccessColor">#0BBA83</Color>
      <Color x:Key="FiliWarningColor">#FFA800</Color>
      <Color x:Key="FiliErrorColor">#F64E62</Color>
      <Color x:Key="FiliDarkColor">#27272F</Color>
      <Color x:Key="FiliBlackColor">#27272F</Color>
      <Color x:Key="FiliWhiteColor">#FFFFFF</Color>

      <Color x:Key="FiliTextPrimaryColor">#B3FFFFFF</Color>
      <Color x:Key="FiliTextSecondaryColor">#80FFFFFF</Color>
      <Color x:Key="FiliTextDisabledColor">#33FFFFFF</Color>

      <Color x:Key="FiliActionDefaultColor">#ADADB1</Color>
      <Color x:Key="FiliActionDisabledColor">#42FFFFFF</Color>
      <Color x:Key="FiliActionDisabledBackgroundColor">#1FFFFFFF</Color>

      <Color x:Key="FiliBackgroundColor">#32333D</Color>
      <Color x:Key="FiliBackgroundGrayColor">#27272F</Color>
      <Color x:Key="FiliSurfaceColor">#373740</Color>

      <Color x:Key="FiliAppbarBackgroundColor">#27272F</Color>
      <Color x:Key="FiliAppbarTextColor">#B3FFFFFF</Color>
      <Color x:Key="FiliDrawerBackgroundColor">#27272F</Color>
      <Color x:Key="FiliDrawerTextColor">#80FFFFFF</Color>
      <Color x:Key="FiliDrawerIconColor">#80FFFFFF</Color>
      <Color x:Key="FiliDrawerBorderColor">#00000000</Color>

      <Color x:Key="FiliLinesDefaultColor">#1FFFFFFF</Color>
      <Color x:Key="FiliLinesInputsColor">#4DFFFFFF</Color>
      <Color x:Key="FiliDividerColor">#1FFFFFFF</Color>
      <Color x:Key="FiliTableLinesColor">#1FFFFFFF</Color>
      <Color x:Key="FiliTableStripedColor">#33FFFFFF</Color>
      <Color x:Key="FiliTableHoverColor">#14FFFFFF</Color>
      <Color x:Key="FiliSkeletonColor">#1CFFFFFF</Color>

      <Color x:Key="FiliPrimaryHoverColor">#0F776BE7</Color>

      <Color x:Key="FiliOverlayHoverColor">#14FFFFFF</Color>
      <Color x:Key="FiliOverlayPressedColor">#29FFFFFF</Color>

      <Color x:Key="FiliInputFilledColor">#17FFFFFF</Color>

      <!-- Same three as Light, same values: varying only in High Contrast. -->
      <Color x:Key="FiliOverlayDarkColor">#80212121</Color>
      <Color x:Key="FiliOverlayLightColor">#80FFFFFF</Color>
      <Color x:Key="FiliTooltipBackgroundColor">#616161</Color>

    </ResourceDictionary>

    <!-- ========================= HIGH CONTRAST ========================== -->
    <!--
      NOT a MudBlazor palette. MudBlazor ships light and dark and nothing else, so there was
      nothing to transcribe here; this variant is derived, and the reference for how an app
      wants it to behave is Fili.PlaySphere's Palette.HighContrast.axaml.

      Three rules produced every value below.

      1. SEPARATION COMES FROM LINES, NOT FROM FILLS. Surface sits one step off the page ground
         and is not doing the work - #0D0D0D against #000000 is a difference nobody can see. What
         divides a card, a menu or a dialog from the page is its outline, which Elevation.axaml
         supplies in this variant as a hard ring in place of a shadow. That is the standard
         high-contrast substitution, and it is why this palette needed no control template edits.

      2. NOTHING IS CONVEYED BY ALPHA. Every line and text token here is opaque. The light and
         dark palettes lean on translucent blacks and whites (#1FFFFFFF for a divider), which
         composite against whatever is behind them; on a black ground a 12% white line is
         invisible. Alpha survives in exactly three places, all of them deliberate overlays
         rather than content: the two state layers, the input fill and the scrims.

      3. DISABLED STILL HAS TO BE LEGIBLE. #CFCFDA against black is about 12:1 - far too strong
         to read as disabled in a normal palette, which is the point. A user who needs this
         variant is not served by a control they cannot read at all, so disabled is signalled by
         being dimmer than enabled rather than by being nearly gone.

      The hues are the MudBlazor ones raised until they clear roughly 10:1 on black, so an app
      that has not overridden anything still looks like this theme rather than like a generic
      black-and-white sheet.
    -->
    <ResourceDictionary x:Key="{x:Static theme:FiliThemeVariants.HighContrast}">

      <Color x:Key="FiliPrimaryColor">#D3C4FF</Color>
      <Color x:Key="FiliPrimaryContrastTextColor">#000000</Color>
      <Color x:Key="FiliSecondaryColor">#FF9DC4</Color>
      <Color x:Key="FiliSecondaryContrastTextColor">#000000</Color>
      <Color x:Key="FiliTertiaryColor">#7BF0D6</Color>
      <Color x:Key="FiliTertiaryContrastTextColor">#000000</Color>

      <Color x:Key="FiliInfoColor">#9CD4FF</Color>
      <Color x:Key="FiliSuccessColor">#8CFFC0</Color>
      <Color x:Key="FiliWarningColor">#FFD166</Color>
      <Color x:Key="FiliErrorColor">#FF9AA8</Color>
      <Color x:Key="FiliDarkColor">#000000</Color>
      <Color x:Key="FiliBlackColor">#000000</Color>
      <Color x:Key="FiliWhiteColor">#FFFFFF</Color>

      <Color x:Key="FiliTextPrimaryColor">#FFFFFF</Color>
      <Color x:Key="FiliTextSecondaryColor">#E8E8EE</Color>
      <Color x:Key="FiliTextDisabledColor">#CFCFDA</Color>

      <Color x:Key="FiliActionDefaultColor">#E8E8EE</Color>
      <Color x:Key="FiliActionDisabledColor">#CFCFDA</Color>
      <!-- Dark, not the line colour. A disabled field filled at #5A5A66 is the BRIGHTEST thing
           on the page, which reads as emphasis - the exact opposite of what it means. Disabled is
           carried by the label staying legible at #CFCFDA, not by the fill shouting. -->
      <Color x:Key="FiliActionDisabledBackgroundColor">#2B2B33</Color>

      <Color x:Key="FiliBackgroundColor">#000000</Color>
      <Color x:Key="FiliBackgroundGrayColor">#000000</Color>
      <Color x:Key="FiliSurfaceColor">#0D0D0D</Color>

      <Color x:Key="FiliAppbarBackgroundColor">#000000</Color>
      <Color x:Key="FiliAppbarTextColor">#FFFFFF</Color>
      <Color x:Key="FiliDrawerBackgroundColor">#000000</Color>
      <Color x:Key="FiliDrawerTextColor">#E8E8EE</Color>
      <Color x:Key="FiliDrawerIconColor">#E8E8EE</Color>
      <Color x:Key="FiliDrawerBorderColor">#9C9CA8</Color>

      <!--
        Inputs get the SAME line as a default border, unlike light and dark where an input
        outline is stronger than a divider. At this contrast there is no headroom left to make
        one stronger than the other, so the distinction is dropped rather than faked.
      -->
      <Color x:Key="FiliLinesDefaultColor">#E8E8EE</Color>
      <Color x:Key="FiliLinesInputsColor">#E8E8EE</Color>
      <Color x:Key="FiliDividerColor">#9C9CA8</Color>
      <Color x:Key="FiliTableLinesColor">#9C9CA8</Color>
      <Color x:Key="FiliTableStripedColor">#1F1F1F</Color>
      <Color x:Key="FiliTableHoverColor">#333333</Color>
      <Color x:Key="FiliSkeletonColor">#2A2A2A</Color>

      <!--
        Selection tint at 35%, where light and dark use 6%. Six percent of anything over black
        is black, so the tint that marks a selected row would simply not exist.
      -->
      <Color x:Key="FiliPrimaryHoverColor">#59D3C4FF</Color>

      <Color x:Key="FiliOverlayHoverColor">#33FFFFFF</Color>
      <Color x:Key="FiliOverlayPressedColor">#59FFFFFF</Color>

      <Color x:Key="FiliInputFilledColor">#26FFFFFF</Color>

      <!--
        Scrims at 90%, not 50%. A half-strength scrim leaves the page legible behind the dialog,
        which is the exact failure this variant exists to prevent: two competing readable layers
        and no way to tell which one has focus. The tooltip loses its grey chip for the same
        reason - at 90% white on #616161 it is the lowest-contrast text in the theme.
      -->
      <Color x:Key="FiliOverlayDarkColor">#E6000000</Color>
      <Color x:Key="FiliOverlayLightColor">#E6FFFFFF</Color>
      <Color x:Key="FiliTooltipBackgroundColor">#000000</Color>

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!--
    Brushes, defined once against the theme-varying Colors above. DynamicResource is
    mandatory here: StaticResource would freeze the light value and the brush would stop
    following the theme at runtime, silently. ResourceResolutionTests guards this.
  -->
  <SolidColorBrush x:Key="FiliPrimaryBrush"               Color="{DynamicResource FiliPrimaryColor}" />
  <SolidColorBrush x:Key="FiliPrimaryContrastTextBrush"   Color="{DynamicResource FiliPrimaryContrastTextColor}" />
  <SolidColorBrush x:Key="FiliSecondaryBrush"             Color="{DynamicResource FiliSecondaryColor}" />
  <SolidColorBrush x:Key="FiliSecondaryContrastTextBrush" Color="{DynamicResource FiliSecondaryContrastTextColor}" />
  <SolidColorBrush x:Key="FiliTertiaryBrush"              Color="{DynamicResource FiliTertiaryColor}" />
  <SolidColorBrush x:Key="FiliTertiaryContrastTextBrush"  Color="{DynamicResource FiliTertiaryContrastTextColor}" />

  <SolidColorBrush x:Key="FiliInfoBrush"    Color="{DynamicResource FiliInfoColor}" />
  <SolidColorBrush x:Key="FiliSuccessBrush" Color="{DynamicResource FiliSuccessColor}" />
  <SolidColorBrush x:Key="FiliWarningBrush" Color="{DynamicResource FiliWarningColor}" />
  <SolidColorBrush x:Key="FiliErrorBrush"   Color="{DynamicResource FiliErrorColor}" />
  <SolidColorBrush x:Key="FiliDarkBrush"    Color="{DynamicResource FiliDarkColor}" />
  <SolidColorBrush x:Key="FiliWhiteBrush"   Color="{DynamicResource FiliWhiteColor}" />

  <SolidColorBrush x:Key="FiliTextPrimaryBrush"   Color="{DynamicResource FiliTextPrimaryColor}" />
  <SolidColorBrush x:Key="FiliTextSecondaryBrush" Color="{DynamicResource FiliTextSecondaryColor}" />
  <SolidColorBrush x:Key="FiliTextDisabledBrush"  Color="{DynamicResource FiliTextDisabledColor}" />

  <SolidColorBrush x:Key="FiliActionDefaultBrush"            Color="{DynamicResource FiliActionDefaultColor}" />
  <SolidColorBrush x:Key="FiliActionDisabledBrush"           Color="{DynamicResource FiliActionDisabledColor}" />
  <SolidColorBrush x:Key="FiliActionDisabledBackgroundBrush" Color="{DynamicResource FiliActionDisabledBackgroundColor}" />

  <SolidColorBrush x:Key="FiliBackgroundBrush"     Color="{DynamicResource FiliBackgroundColor}" />
  <SolidColorBrush x:Key="FiliBackgroundGrayBrush" Color="{DynamicResource FiliBackgroundGrayColor}" />
  <SolidColorBrush x:Key="FiliSurfaceBrush"        Color="{DynamicResource FiliSurfaceColor}" />

  <SolidColorBrush x:Key="FiliAppbarBackgroundBrush" Color="{DynamicResource FiliAppbarBackgroundColor}" />
  <SolidColorBrush x:Key="FiliAppbarTextBrush"       Color="{DynamicResource FiliAppbarTextColor}" />
  <SolidColorBrush x:Key="FiliDrawerBackgroundBrush" Color="{DynamicResource FiliDrawerBackgroundColor}" />
  <SolidColorBrush x:Key="FiliDrawerTextBrush"       Color="{DynamicResource FiliDrawerTextColor}" />
  <SolidColorBrush x:Key="FiliDrawerIconBrush"       Color="{DynamicResource FiliDrawerIconColor}" />
  <SolidColorBrush x:Key="FiliDrawerBorderBrush"     Color="{DynamicResource FiliDrawerBorderColor}" />

  <SolidColorBrush x:Key="FiliLinesDefaultBrush" Color="{DynamicResource FiliLinesDefaultColor}" />
  <SolidColorBrush x:Key="FiliLinesInputsBrush"  Color="{DynamicResource FiliLinesInputsColor}" />
  <SolidColorBrush x:Key="FiliDividerBrush"      Color="{DynamicResource FiliDividerColor}" />
  <SolidColorBrush x:Key="FiliTableLinesBrush"   Color="{DynamicResource FiliTableLinesColor}" />
  <SolidColorBrush x:Key="FiliTableStripedBrush" Color="{DynamicResource FiliTableStripedColor}" />
  <SolidColorBrush x:Key="FiliTableHoverBrush"   Color="{DynamicResource FiliTableHoverColor}" />
  <SolidColorBrush x:Key="FiliSkeletonBrush"     Color="{DynamicResource FiliSkeletonColor}" />

  <SolidColorBrush x:Key="FiliPrimaryHoverBrush"   Color="{DynamicResource FiliPrimaryHoverColor}" />
  <!--
    Scrim colours for a modal surface. NON-VARYING, like elevation: Palette.cs specifies them as
    literal colours - OverlayDark is #212121 at 50%, not black - and PaletteDark does not override
    either one, so the same scrim is correct in both variants.
  -->
  <SolidColorBrush x:Key="FiliOverlayDarkBrush"  Color="{DynamicResource FiliOverlayDarkColor}" />
  <SolidColorBrush x:Key="FiliOverlayLightBrush" Color="{DynamicResource FiliOverlayLightColor}" />

  <SolidColorBrush x:Key="FiliOverlayHoverBrush"   Color="{DynamicResource FiliOverlayHoverColor}" />
  <SolidColorBrush x:Key="FiliOverlayPressedBrush" Color="{DynamicResource FiliOverlayPressedColor}" />

  <!--
    Tooltip fill. NON-VARYING on purpose, and transcribed rather than chosen: MudBlazor _tooltip.scss
    paints background-color from the CSS variable `mud-palette-gray-darker`, which is
    Palette.GrayDarker =
    Colors.Gray.Darken2 = #616161, SOLID. An earlier version used 90% alpha, which was Material
    spec rather than what MudBlazor renders.
  -->
  <SolidColorBrush x:Key="FiliTooltipBackgroundBrush" Color="{DynamicResource FiliTooltipBackgroundColor}" />

  <SolidColorBrush x:Key="FiliInputFilledBrush"    Color="{DynamicResource FiliInputFilledColor}" />

</ResourceDictionary>
