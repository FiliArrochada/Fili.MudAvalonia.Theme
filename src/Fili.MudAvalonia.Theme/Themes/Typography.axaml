<!--
  Typography tokens, from MudBlazor Themes/Models/Typography.cs.

  Two unit conversions were needed, and both matter:

    * rem -> px at a 16px root. MudBlazor default body text is .875rem = 14px, NOT 16px.
      That smaller base is a large part of why the look reads dense and tidy.

    * CSS line-height and letter-spacing are ratios and em; Avalonia LineHeight and
      LetterSpacing are absolute device-independent pixels. So line-height 1.43 on 14px
      becomes LineHeight 20, and letter-spacing .01071em on 14px becomes 0.15.

  Roboto is EMBEDDED (Assets/Fonts, SIL OFL 1.1), so the look does not depend on what the host
  happens to have installed. The avares: URI points at the folder and names the family after
  the '#'; Avalonia scans every font in that folder and matches on family name plus weight.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <FontFamily x:Key="FiliFontFamily">avares://Fili.MudAvalonia.Theme/Assets/Fonts#Roboto</FontFamily>

  <!-- Default / body2: the app-wide baseline -->
  <sys:Double x:Key="FiliFontSize">14</sys:Double>
  <sys:Double x:Key="FiliLineHeight">20</sys:Double>
  <sys:Double x:Key="FiliLetterSpacing">0.15</sys:Double>

  <sys:Double x:Key="FiliH1FontSize">96</sys:Double>
  <sys:Double x:Key="FiliH1LineHeight">112</sys:Double>
  <sys:Double x:Key="FiliH1LetterSpacing">-1.5</sys:Double>

  <sys:Double x:Key="FiliH2FontSize">60</sys:Double>
  <sys:Double x:Key="FiliH2LineHeight">72</sys:Double>
  <sys:Double x:Key="FiliH2LetterSpacing">-0.5</sys:Double>

  <sys:Double x:Key="FiliH3FontSize">48</sys:Double>
  <sys:Double x:Key="FiliH3LineHeight">56</sys:Double>
  <sys:Double x:Key="FiliH3LetterSpacing">0</sys:Double>

  <sys:Double x:Key="FiliH4FontSize">34</sys:Double>
  <sys:Double x:Key="FiliH4LineHeight">42</sys:Double>
  <sys:Double x:Key="FiliH4LetterSpacing">0.25</sys:Double>

  <sys:Double x:Key="FiliH5FontSize">24</sys:Double>
  <sys:Double x:Key="FiliH5LineHeight">32</sys:Double>
  <sys:Double x:Key="FiliH5LetterSpacing">0</sys:Double>

  <sys:Double x:Key="FiliH6FontSize">20</sys:Double>
  <sys:Double x:Key="FiliH6LineHeight">32</sys:Double>
  <sys:Double x:Key="FiliH6LetterSpacing">0.15</sys:Double>

  <sys:Double x:Key="FiliSubtitle1FontSize">16</sys:Double>
  <sys:Double x:Key="FiliSubtitle1LineHeight">28</sys:Double>
  <sys:Double x:Key="FiliSubtitle1LetterSpacing">0.15</sys:Double>

  <sys:Double x:Key="FiliSubtitle2FontSize">14</sys:Double>
  <sys:Double x:Key="FiliSubtitle2LineHeight">22</sys:Double>
  <sys:Double x:Key="FiliSubtitle2LetterSpacing">0.1</sys:Double>

  <sys:Double x:Key="FiliBody1FontSize">16</sys:Double>
  <sys:Double x:Key="FiliBody1LineHeight">24</sys:Double>
  <sys:Double x:Key="FiliBody1LetterSpacing">0.15</sys:Double>

  <sys:Double x:Key="FiliBody2FontSize">14</sys:Double>
  <sys:Double x:Key="FiliBody2LineHeight">20</sys:Double>
  <sys:Double x:Key="FiliBody2LetterSpacing">0.15</sys:Double>

  <!-- Button text is uppercase with wide tracking. Small detail, very load-bearing. -->
  <sys:Double x:Key="FiliButtonFontSize">14</sys:Double>
  <sys:Double x:Key="FiliButtonLineHeight">24</sys:Double>
  <sys:Double x:Key="FiliButtonLetterSpacing">0.4</sys:Double>

  <sys:Double x:Key="FiliCaptionFontSize">12</sys:Double>
  <sys:Double x:Key="FiliCaptionLineHeight">20</sys:Double>
  <sys:Double x:Key="FiliCaptionLetterSpacing">0.4</sys:Double>

  <sys:Double x:Key="FiliOverlineFontSize">12</sys:Double>
  <sys:Double x:Key="FiliOverlineLineHeight">32</sys:Double>
  <sys:Double x:Key="FiliOverlineLetterSpacing">1</sys:Double>

</ResourceDictionary>
