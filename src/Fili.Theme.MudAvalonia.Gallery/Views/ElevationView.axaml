<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fili.Theme.MudAvalonia.Gallery.Views.ElevationView">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Classes="h6" Text="Elevation ladder" />
      <TextBlock Classes="body2" Foreground="{DynamicResource FiliTextSecondaryBrush}"
                 TextWrapping="Wrap"
                 MaxWidth="680"
                 HorizontalAlignment="Left"
                 Text="Levels 0 to 24, each three stacked shadow layers. This is the biggest single difference from Fluent, which separates surfaces with a one-pixel border instead. Check the low end carefully: 1 through 4 are what most of an app actually uses, and they should be distinguishable without being heavy." />
      <WrapPanel x:Name="Root" ItemWidth="150" ItemHeight="130" />
    </StackPanel>
  </ScrollViewer>

</UserControl>
