<!--
  Control themes, aggregated. One file per control under Controls/.

  Every theme is declared under a Fili* name and then aliased to its {x:Type} key at the bottom of
  its own file, so it applies with no markup change. A CLASS ONLY EVER NAMES A VARIANT.

  That is the opposite of the rule this package started with. While it layered over Fluent, keying
  to a type was dangerous, because Avalonia composes built-in controls out of other built-in
  controls: {x:Type Button} reaches the spinners inside NumericUpDown, {x:Type TextBox} reaches
  the editor inside AutoCompleteBox, NumericUpDown, DatePicker and editable ComboBox. Now that the
  base is a fork this repo owns, that reach is the POINT - those embedded controls should look
  like this theme, and NumericUpDown below is built assuming exactly that.

  Order inside this file matters only for Icons.axaml, which must be first: several control
  themes StaticResource its glyphs.

  The line for what belongs here at all: RETEMPLATING an Avalonia control is in scope, INVENTING
  one is not. Button needed a template because Button has no BoxShadow. TextBox needed one because
  a floating label is structure, not colour. A Card or a Chip would be a new control and belongs
  in a package that depends on this one.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <!-- First: CheckBox and RadioButton StaticResource these glyphs. -->
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Icons.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/Button.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/TextBox.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/CheckBox.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/RadioButton.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/ToggleSwitch.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/Slider.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/ToggleButton.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/HyperlinkButton.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/SplitButton.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/Chip.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/ComboBox.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/ListBox.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/TreeView.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/NumericUpDown.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/AutoCompleteBox.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/Expander.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/Fields.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/ProgressBar.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/Separator.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/TabControl.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/TabStrip.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/PipsPager.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/ScrollBar.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/Menu.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/Notifications.axaml" />
    <ResourceInclude Source="avares://Fili.Theme.MudAvalonia/Themes/Controls/Overlays.axaml" />
  </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
