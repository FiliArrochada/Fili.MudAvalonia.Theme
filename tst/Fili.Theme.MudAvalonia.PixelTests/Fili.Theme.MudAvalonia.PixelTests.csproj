<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Fili.Theme.MudAvalonia.PixelTests</RootNamespace>
    <AssemblyName>Fili.Theme.MudAvalonia.PixelTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Skia plus headless drawing turned OFF is what makes a frame exist; see GalleryFrames. -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The gallery's desktop head, because that is where the frame catalogue and the single
      rendering routine live. A second copy of either here would drift from what the screenshot
      mode produces, and baselines that no longer describe the screenshots are worse than none.
    -->
    <ProjectReference Include="..\..\src\Fili.Theme.MudAvalonia.Gallery.Desktop\Fili.Theme.MudAvalonia.Gallery.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Committed, and read from the source tree rather than the output: they are reviewed in
         diffs, and an accepted baseline has to land in the repository, not in bin. -->
    <None Include="Baselines\**\*.png" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
